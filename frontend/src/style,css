@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap");

/* Shared type, color tokens, and baseline element behavior used by every screen. */
:root {
  font-family: "DM Sans", sans-serif;
  color: #202020;
  background: #f5f5f5;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --ink: #202020;
  --muted: #737373;
  --green: #242424;
  --green-dark: #080808;
  --line: #e2e2e2;
  --paper: #fff;
  --mint: #ededed;
  --peach: #ededed;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; min-height: 100vh; }
button, input, textarea { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible, textarea:focus-visible, a:focus-visible {
  outline: 3px solid #777;
  outline-offset: 3px;
}

h1, h2, h3, p { margin-top: 0; }
h1, h2, h3, .brand { font-family: Manrope, sans-serif; }
h1 { margin-bottom: 12px; font-size: clamp(29px, 3vw, 39px); line-height: 1.2; letter-spacing: -1.5px; }
h2 { margin-bottom: 8px; font-size: 23px; letter-spacing: -.7px; }
h3 { margin-bottom: 8px; font-size: 19px; letter-spacing: -.45px; }
.muted { color: var(--muted); }
.eyebrow { margin-bottom: 10px; color: #789080; font-size: 10px; font-weight: 700; letter-spacing: 1.35px; }

.button {
  min-height: 41px;
  padding: 0 16px;
  border: 1px solid transparent;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  transition: background .18s ease, transform .18s ease;
}
.button:hover { transform: translateY(-1px); }
.button:disabled { cursor: wait; opacity: .65; }
.button-primary { color: #fff; background: var(--green); }
.button-primary:hover { background: var(--green-dark); }
.button-outline { color: var(--green); border-color: #cbd8ce; background: white; }
.button-outline:hover, .button-quiet:hover { background: #edf4ee; }
.button-quiet { color: #59665e; border-color: var(--line); background: #f6f8f5; }
.full-width { width: 100%; }
.text-button { padding: 0; border: 0; color: var(--green); background: transparent; font-size: 12px; font-weight: 700; }
.text-button:hover { color: #547a65; }

/* Sign-in and registration split layout, form controls, and feedback states. */
.auth-layout { display: grid; grid-template-columns: 1fr minmax(360px, 460px); gap: 9vw; align-items: center; width: min(1180px, calc(100% - 64px)); min-height: 100vh; margin: auto; padding: 64px 0; }
.auth-copy { max-width: 540px; }
.auth-copy h1 { max-width: 500px; margin: 18px 0; font-size: clamp(43px, 6vw, 68px); line-height: 1.08; letter-spacing: -3.5px; }
.auth-copy > p:not(.eyebrow) { max-width: 390px; color: var(--muted); font-size: 16px; line-height: 1.7; }
.auth-note { display: flex; gap: 12px; align-items: center; margin-top: 64px; color: #65766b; font-size: 12px; }
.note-mark { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 50%; color: var(--green); background: #e3efe5; font-size: 19px; }
.auth-card { padding: 40px; border: 1px solid #e8ece6; border-radius: 16px; background: white; box-shadow: 0 16px 50px #263b2e0a; }
.brand-mark { display: inline-grid; width: 38px; height: 38px; place-items: center; border-radius: 11px; color: white; background: var(--green); font-family: Manrope, sans-serif; font-weight: 800; }
.auth-card > .brand-mark { margin-bottom: 27px; }
.auth-card h2 { margin-bottom: 7px; }
.auth-card > .muted { margin-bottom: 26px; font-size: 13px; }
.stack { display: flex; flex-direction: column; gap: 16px; }
.stack label { display: flex; flex-direction: column; gap: 7px; color: #45554b; font-size: 12px; font-weight: 700; }
.stack input, .stack textarea { width: 100%; padding: 12px 13px; border: 1px solid #dce3dc; border-radius: 7px; color: var(--ink); background: #fff; font-size: 13px; }
.stack input:focus, .stack textarea:focus { border-color: #91ad98; outline: 2px solid #91ad9830; }
.stack textarea { resize: vertical; }
.optional { color: #99a39b; font-weight: 400; }
.form-error { margin: -2px 0 0; color: #a13d34; font-size: 12px; }
.switch-auth { margin: 22px 0 0; color: var(--muted); text-align: center; font-size: 12px; }
.loading-screen { display: grid; min-height: 100vh; place-items: center; color: var(--muted); }
